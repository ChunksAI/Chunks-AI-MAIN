# Chunks(v.2) — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Backend ──────────────────────────────────────────────────────────────────
# URL of the Chunks FastAPI backend. Defaults to production if not set.
NEXT_PUBLIC_API_URL=https://api.chunks.online

# (Optional) Server-only override for the backend URL used in Next.js API routes.
# Set this when the backend is reachable from the server via a private/internal
# URL that differs from the public-facing NEXT_PUBLIC_API_URL.
# Falls back to NEXT_PUBLIC_API_URL when not set.
# BACKEND_API_URL=http://localhost:8000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL and anon/public key.
# Found in: Supabase Dashboard → Settings → API
# If not set, the app will attempt to fetch them from the backend /api/config endpoint.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
