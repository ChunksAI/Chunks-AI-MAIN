10:["$","section",null,{"className":"legal-section","children":[["$","h2",null,{"children":"7. Children's Privacy"}],["$","p",null,{"children":["Chunks AI is not directed at children under 13 (or the applicable age of digital consent in your jurisdiction). We do not knowingly collect personal data from children. If you believe a child has provided us with personal data, please contact us at"," ",["$","a",null,{"href":"mailto:privacy@chunks.online","children":"privacy@chunks.online"}],"."]}]]}]
