b:["$","section",null,{"className":"legal-section","children":[["$","h2",null,{"children":"2. How We Use Your Information"}],["$","ul",null,{"children":[["$","li",null,{"children":"To provide, operate, and improve the Chunks AI platform."}],["$","li",null,{"children":"To personalise your study experience (AI responses, recommendations)."}],["$","li",null,{"children":"To process payments and manage your subscription."}],["$","li",null,{"children":"To send important account notifications (billing, security alerts)."}],["$","li",null,{"children":"To send optional product updates and study reminders (you can unsubscribe anytime)."}],["$","li",null,{"children":"To analyse aggregated, anonymised usage trends to improve the product."}],["$","li",null,{"children":"To detect and prevent fraud, abuse, and security incidents."}],["$","li",null,{"children":"To comply with legal obligations."}]]}]]}]
c:["$","section",null,{"className":"legal-section","children":[["$","h2",null,{"children":"3. How We Share Your Information"}],["$","p",null,{"children":"We do not sell your personal data. We may share information with:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"AI providers"}]," — your messages and document content are sent to third-party AI APIs (e.g., Anthropic, OpenAI) to generate responses. These providers are bound by their own privacy policies and data processing agreements."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Infrastructure providers"}]," — hosting, database, file storage, and CDN services (e.g., Supabase, Vercel, AWS)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Analytics"}]," — aggregated, anonymised usage data may be shared with analytics providers."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Legal requirements"}]," — we may disclose information if required by law or to protect the rights and safety of users."]}]]}]]}]
d:["$","section",null,{"className":"legal-section","children":[["$","h2",null,{"children":"4. Data Retention"}],["$","p",null,{"children":["We retain your account data for as long as your account is active. Chat history is stored according to your settings (you can delete it anytime in Settings → Data controls). Uploaded documents are retained until you delete them. You can request deletion of your account and all associated data by contacting"," ",["$","a",null,{"href":"mailto:privacy@chunks.online","children":"privacy@chunks.online"}],"."]}]]}]
