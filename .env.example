# ─────────────────────────────────────────────────────────────────────────────
# Chunks AI — Environment Variables
#
# Copy this file to .env and fill in your values before running docker-compose:
#   cp .env.example .env
#
# .env is git-ignored so your secrets will never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Your OpenRouter API key — required for all AI features.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# LLM model identifier (defaults to openai/gpt-oss-20b:nitroe if not set).
# MODEL=openai/gpt-4o-mini

# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL from Supabase → Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key (has full DB access — keep secret).
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Anon / public key (used by the browser-side SDK).
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT secret from Supabase → Settings → API → JWT Settings.
# Enables local JWT verification (eliminates one Supabase REST call per request).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Cloudflare R2 (book / document storage) ───────────────────────────────────
# Public bucket URL for serving PDF covers, book chunks, etc.
R2_BUCKET_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Optional ──────────────────────────────────────────────────────────────────
# Sentry DSN for error monitoring — leave blank to disable.
SENTRY_DSN=
