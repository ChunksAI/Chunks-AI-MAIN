{
  "redirects": [
    { "source": "/index.html",  "destination": "/ChunksAI", "permanent": true },
    { "source": "/privacy.html","destination": "/privacy",  "permanent": true },
    { "source": "/terms.html",  "destination": "/terms",    "permanent": true },
    { "source": "/admin.html",  "destination": "/admin",    "permanent": true },
    { "source": "/app",         "destination": "/home",     "permanent": true },
    { "source": "/guest.html",  "destination": "/guest",    "permanent": true }
  ],
  "rewrites": [
    { "source": "/",                     "destination": "/app.html" },
    { "source": "/ChunksAI",             "destination": "/homepage.html" },
    { "source": "/about",                "destination": "/homepage.html" },
    { "source": "/features",             "destination": "/homepage.html" },
    { "source": "/features/:path",       "destination": "/homepage.html" },
    { "source": "/how-it-works",         "destination": "/homepage.html" },
    { "source": "/how-it-works/:path",   "destination": "/homepage.html" },
    { "source": "/pricing",              "destination": "/homepage.html" },
    { "source": "/pricing/:path",        "destination": "/homepage.html" },
    { "source": "/company",              "destination": "/homepage.html" },
    { "source": "/company/about",        "destination": "/homepage.html" },
    { "source": "/company/news",         "destination": "/homepage.html" },
    { "source": "/company/contact",      "destination": "/homepage.html" },
    { "source": "/company/privacy",      "destination": "/privacy.html" },
    { "source": "/company/terms",        "destination": "/terms.html" },
    { "source": "/home",                 "destination": "/app.html" },
    { "source": "/guest",                "destination": "/app.html" },
    { "source": "/guest/:path*",         "destination": "/app.html" },
    { "source": "/privacy",              "destination": "/privacy.html" },
    { "source": "/terms",                "destination": "/terms.html" },
    { "source": "/admin",                "destination": "/admin.html" },
    { "source": "/covers/:path",         "destination": "/covers/:path" },
    { "source": "/assets/:path",         "destination": "/assets/:path" },
    { "source": "/public/:path",         "destination": "/:path" },
    { "source": "/home/:path*",          "destination": "/app.html" },
    { "source": "/:path*",               "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(home|guest|admin|privacy|terms|ChunksAI)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "worker-src 'self' blob:;" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/covers/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
